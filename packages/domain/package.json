{
  "name": "@warekai/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Motor de costes de cocina. TypeScript puro, sin dependencias de infraestructura.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
