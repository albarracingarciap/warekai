# --- Base de datos -----------------------------------------------------------
# El usuario `warekai` NO es superusuario en produccion: la seguridad a nivel de
# fila (RLS) se salta para los superusuarios y para el owner de la tabla.
DATABASE_URL=postgresql://warekai:warekai@localhost:5432/warekai

# --- Cola de trabajos --------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --- API ---------------------------------------------------------------------
NODE_ENV=development
API_PORT=3000
API_CORS_ORIGIN=http://localhost:5173

# --- Autenticacion -----------------------------------------------------------
# Genera secretos distintos por entorno:  openssl rand -base64 48
JWT_ACCESS_SECRET=cambia-esto-en-desarrollo-minimo-32-caracteres
JWT_REFRESH_SECRET=cambia-esto-tambien-minimo-32-caracteres-distinto
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Vida del token que se obtiene con PIN en un dispositivo de confianza.
# Corto a proposito: una tablet de cocina se queda desatendida.
PIN_ACCESS_TTL=8h

# --- Frontend (prefijo VITE_ obligatorio para exponerlas al bundle) ----------
VITE_API_URL=http://localhost:3000
